{
  "git.autofetch": false,
  "git.autorefresh": false,
  "git.detectSubmodules": false,
  "git.untrackedChanges": "separate",
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/node_modules/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "**/TestResults/**": true
  },
  "files.exclude": {
    "**/bin": true,
    "**/obj": true
  }
}
