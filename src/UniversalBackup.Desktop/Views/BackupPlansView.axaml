<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UniversalBackup.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="UniversalBackup.Desktop.Views.BackupPlansView"
             x:DataType="vm:BackupPlansViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Margin="32">
            <!-- Header Card -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0"
                              Data="{StaticResource NavIconPlans}"
                              Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                              Width="32" Height="32"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Automated Backup Plans &amp; Schedules"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <TextBlock Text="Configure OS Task Scheduler and systemd background schedules, retention rules, and gaming suppression."
                                   FontSize="13"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Command="{Binding CreateNewPlanCommand}"
                            Classes="accent"
                            Padding="16,8"
                            CornerRadius="6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="+ New Plan" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Plan Cards -->
            <StackPanel Spacing="12">
                <!-- Plan 1 -->
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Daily Gamer Protection" FontSize="16" FontWeight="Bold" />
                                <Border Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                        CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Active" FontSize="11" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Runs daily at 10:00 PM • Suppressed when fullscreen games are running."
                                       FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <TextBlock Text="Sources: Steam saves, Epic manifests, Minecraft, AppData game saves."
                                       FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="Keep 14 daily"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                    </Grid>
                </Border>

                <!-- Plan 2 -->
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Weekly Full Workstation" FontSize="16" FontWeight="Bold" />
                                <Border Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                        CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Active" FontSize="11" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Runs every Sunday at 02:00 AM • VSS Filesystem consistency enabled."
                                       FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <TextBlock Text="Sources: Documents, Photos, Developer Repositories, Desktop Settings, Browsers."
                                       FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="Keep 8 weekly"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
