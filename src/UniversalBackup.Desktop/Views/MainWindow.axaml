<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UniversalBackup.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        x:Class="UniversalBackup.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Universal Backup Utility — TreeDataGrid Virtualization Spike (250,000 Nodes)">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">
        <!-- 1. Header & Telemetry Metrics Section -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Vertical" Spacing="4">
                    <TextBlock Text="Universal Backup Utility"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                    <TextBlock Text="Phase 0 Feasibility Spike: 250,000 Nodes Virtualization &amp; Tri-State Checkbox Bubbling"
                               FontSize="13"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Metric Badge 1: Node Count -->
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            CornerRadius="6"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Total Nodes:" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TotalNodesCount, StringFormat='{}{0:N0}'}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Metric Badge 2: Memory -->
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            CornerRadius="6"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Allocated Memory:" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MemoryUsageMb}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#10B981" />
                        </StackPanel>
                    </Border>

                    <!-- Metric Badge 3: Generation Time -->
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            CornerRadius="6"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Gen Time:" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GenerationTime}"
                                       FontSize="12"
                                       FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Action Toolbar -->
        <Border Grid.Row="1" Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                <Button Grid.Column="0"
                        Command="{Binding LoadTreeCommand}"
                        Classes="accent"
                        IsEnabled="{Binding !IsBusy}"
                        Padding="16,8"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚡ Load 250,000 Nodes (Benchmark)" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        Command="{Binding SelectAllCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Padding="12,8"
                        Margin="0,0,8,0">
                    <TextBlock Text="Select All" />
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding ClearSelectionCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Padding="12,8"
                        Margin="0,0,8,0">
                    <TextBlock Text="Clear Selection" />
                </Button>

                <Button Grid.Column="3"
                        Command="{Binding ExpandLevel1Command}"
                        IsEnabled="{Binding !IsBusy}"
                        Padding="12,8">
                    <TextBlock Text="Expand Level 1" />
                </Button>

                <!-- Status indicator -->
                <ProgressBar Grid.Column="5"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}"
                             Width="150"
                             Height="16"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 3. Central Virtualized TreeDataGrid -->
        <Border Grid.Row="2"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <TreeDataGrid Source="{Binding TreeSource}"
                          Margin="8" />
        </Border>

        <!-- 4. Bottom Status & Telemetry Bar -->
        <Border Grid.Row="3" Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="UI Thread: 60 FPS • Tri-state bubbling: O(log N) • Memory threshold: &lt; 150 MB"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
