<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UniversalBackup.Desktop.ViewModels"
        xmlns:models="using:UniversalBackup.Desktop.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        x:Class="UniversalBackup.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Universal Backup Utility">

    <Grid ColumnDefinitions="250,*">

        <!-- ================================================================= -->
        <!-- 1. Permanent Left Navigation Rail                                  -->
        <!-- ================================================================= -->
        <Border Grid.Column="0"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- 1.1 App Brand Header -->
                <Border Grid.Row="0" Padding="20,20,20,16">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                        <!-- Brand Icon Circle -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Width="36" Height="36"
                                CornerRadius="8"
                                Background="{DynamicResource SystemControlHighlightAccentBrush}">
                            <PathIcon Data="{StaticResource IconShieldCheck}"
                                      Foreground="White"
                                      Width="18" Height="18"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center" />
                        </Border>

                        <!-- Brand Title & Version -->
                        <StackPanel Grid.Row="0" Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Universal Backup"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                        BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,1">
                                    <TextBlock Text="v1.0-preview"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1.2 Permanent Navigation Items List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,4,8,8">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:NavigationItemModel">
                                <Button Classes="nav-button"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectNavigationItemCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding Tooltip}"
                                        Margin="0,2">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Height="36">
                                        <!-- Active Left Accent Indicator Bar -->
                                        <Border Grid.Column="0"
                                                Width="3"
                                                Height="18"
                                                CornerRadius="2"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                                IsVisible="{Binding IsSelected}" />

                                        <!-- Navigation Icon -->
                                        <PathIcon Grid.Column="1"
                                                  Data="{Binding IconGeometry}"
                                                  Width="18" Height="18"
                                                  Margin="4,0,12,0"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

                                        <!-- Section Title -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

                                        <!-- Optional Badge -->
                                        <Border Grid.Column="3"
                                                IsVisible="{Binding BadgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                Margin="4,0,0,0">
                                            <TextBlock Text="{Binding BadgeText}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 1.3 Sidebar Footer: Engine Status & Theme Toggle -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <StackPanel Spacing="10">

                        <!-- Engine Status Indicator -->
                        <Grid ColumnDefinitions="Auto,*">
                            <Ellipse Grid.Column="0"
                                     Width="8" Height="8"
                                     Fill="#10B981"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding EngineStatusText}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Privilege / VSS Status Badge -->
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon Grid.Column="0"
                                      Data="{StaticResource IconShieldCheck}"
                                      Width="12" Height="12"
                                      Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PrivilegeStatusText}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Quick Theme Switch Toggle Button -->
                        <Button Classes="nav-button"
                                Command="{Binding ToggleThemeCommand}"
                                Padding="8,6"
                                Margin="0,4,0,0">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Grid.Column="0"
                                          Data="{StaticResource IconTheme}"
                                          Width="14" Height="14"
                                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentTheme, StringFormat='Theme: {0}'}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 2. Main Content & Telemetry Area                                   -->
        <!-- ================================================================= -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

            <!-- 2.1 Top Page Title & Header Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="28,20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <TextBlock Text="{Binding CurrentPageSubtitle}"
                                   FontSize="13"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>

                    <!-- Global Activity Progress Bar -->
                    <ProgressBar Grid.Column="1"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsBusy}"
                                 Width="160"
                                 Height="8"
                                 CornerRadius="4"
                                 VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 2.2 Active View Content Host (Dynamic via ViewLocator) -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentView}" />

            <!-- 2.3 Bottom Telemetry & Status Bar -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,8">
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Left: Status message -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               VerticalAlignment="Center" />

                    <!-- Right: Platform telemetry -->
                    <TextBlock Grid.Column="1"
                               Text="UI: 60 FPS • SQLite: WAL mode • Zero hardcoded paths"
                               FontSize="11"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

        </Grid>

    </Grid>
</Window>
