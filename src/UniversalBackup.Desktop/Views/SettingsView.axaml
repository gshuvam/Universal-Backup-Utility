<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UniversalBackup.Desktop.ViewModels"
             xmlns:services="using:UniversalBackup.Desktop.Services"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="UniversalBackup.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Margin="32">
            <!-- Header Card -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0"
                              Data="{StaticResource NavIconSettings}"
                              Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                              Width="32" Height="32"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Settings &amp; Engine Preferences"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <TextBlock Text="Customize application appearance, engine binaries, and VSS elevation preferences."
                                   FontSize="13"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Theme Preferences Card -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Application Theme" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="Select Light, Dark, or follow System Default theme variant."
                                   FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="System"
                                Command="{Binding SetThemeCommand}">
                            <Button.CommandParameter>
                                <services:AppTheme>System</services:AppTheme>
                            </Button.CommandParameter>
                        </Button>
                        <Button Content="Dark"
                                Command="{Binding SetThemeCommand}">
                            <Button.CommandParameter>
                                <services:AppTheme>Dark</services:AppTheme>
                            </Button.CommandParameter>
                        </Button>
                        <Button Content="Light"
                                Command="{Binding SetThemeCommand}">
                            <Button.CommandParameter>
                                <services:AppTheme>Light</services:AppTheme>
                            </Button.CommandParameter>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Engine Paths Card -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Engine Binary Resolution" FontSize="15" FontWeight="Bold" />

                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                        <!-- Restic -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Restic Engine:"
                                   VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ResticPath}"
                                 IsReadOnly="True" Margin="0,4,0,8" />

                        <!-- Rclone -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Rclone Cloud Transport:"
                                   VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RclonePath}"
                                 IsReadOnly="True" Margin="0,4,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Status message -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
