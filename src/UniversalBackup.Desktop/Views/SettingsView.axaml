<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UniversalBackup.Desktop.ViewModels"
             xmlns:services="using:UniversalBackup.Desktop.Services"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="UniversalBackup.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Margin="32">
            <!-- Header Card -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0"
                              Data="{StaticResource NavIconSettings}"
                              Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                              Width="32" Height="32"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Settings &amp; Engine Preferences"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <TextBlock Text="Customize application appearance, engine diagnostics, staging cache, and safety guardians."
                                   FontSize="13"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Content="Reset Defaults" Command="{Binding ResetToDefaultsCommand}" Padding="12,8" CornerRadius="6" />
                        <Button Content="Save Preferences" Command="{Binding SavePreferencesCommand}" Classes="accent" Padding="16,8" CornerRadius="6" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. Theme Preferences Card -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Application Theme" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="Select Light, Dark, or follow System Default theme variant."
                                   FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="System"
                                Command="{Binding SetThemeCommand}">
                            <Button.CommandParameter>
                                <services:AppTheme>System</services:AppTheme>
                            </Button.CommandParameter>
                        </Button>
                        <Button Content="Dark"
                                Command="{Binding SetThemeCommand}">
                            <Button.CommandParameter>
                                <services:AppTheme>Dark</services:AppTheme>
                            </Button.CommandParameter>
                        </Button>
                        <Button Content="Light"
                                Command="{Binding SetThemeCommand}">
                            <Button.CommandParameter>
                                <services:AppTheme>Light</services:AppTheme>
                            </Button.CommandParameter>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Engine Binary Diagnostics Card -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Engine Binary Resolution" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="Diagnostic locations for underlying restic and rclone engine runtimes."
                                       FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding DetectEnginesCommand}"
                                Padding="12,6"
                                CornerRadius="6">
                            <TextBlock Text="↻ Detect Engines" FontSize="12" FontWeight="SemiBold" />
                        </Button>
                    </Grid>

                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                        <!-- Restic -->
                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,12">
                            <TextBlock Text="Restic Engine:" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="Backup &amp; Snapshot" FontSize="10" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,4,0,12">
                            <TextBox Text="{Binding ResticPath}" IsReadOnly="True" />
                            <TextBlock Text="{Binding ResticStatusMessage}" FontSize="11" Foreground="#10B981" />
                        </StackPanel>

                        <!-- Rclone -->
                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="Rclone Engine:" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="Cloud Transport" FontSize="10" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" Margin="0,4,0,0">
                            <TextBox Text="{Binding RclonePath}" IsReadOnly="True" />
                            <TextBlock Text="{Binding RcloneStatusMessage}" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Staging & Performance Card -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Performance &amp; Staging Cache" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="Configure temporary preimage staging directory and cloud bandwidth limits."
                                   FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                        <!-- Staging Cache Path -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Staging Cache Path:"
                                   VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StagingCachePath}"
                                 Margin="0,4,0,10" />

                        <!-- Bandwidth Throttling -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Cloud Bandwidth Limit:"
                                   VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding BandwidthLimitOptions}"
                                  SelectedItem="{Binding SelectedBandwidthLimit}"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,4,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Safety Guardians Card -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Safety Guardians &amp; Policies" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="Guardrails preventing file contention, gameplay frame drops, and accidental data loss."
                                   FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="10" Margin="0,4,0,0">
                        <!-- VSS Toggle -->
                        <CheckBox IsChecked="{Binding EnableVssByDefault}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Enable Volume Shadow Copy (VSS) by default" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Captures locked files, active browser databases, and open save files without sharing violations."
                                           FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </CheckBox>

                        <!-- Gaming Session Suppression Toggle -->
                        <CheckBox IsChecked="{Binding SuppressDuringGaming}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Suppress background backups during gaming sessions" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Automatically delays scheduled runs when DirectX/Vulkan fullscreen games are running."
                                           FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </CheckBox>

                        <!-- Pruning Safeguard Toggle -->
                        <CheckBox IsChecked="{Binding EnforcePruningSafeguard}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Enforce Sole-Snapshot Pruning Safeguard" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Guarantees retention pruning can never delete the last remaining complete backup of any plan."
                                           FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status Banner -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
