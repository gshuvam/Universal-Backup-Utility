<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UniversalBackup.Desktop.ViewModels"
             xmlns:models="using:UniversalBackup.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="UniversalBackup.Desktop.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="32">
            <!-- Header Card -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0"
                              Data="{StaticResource NavIconActivity}"
                              Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                              Width="32" Height="32"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Activity &amp; Audit Journal"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <TextBlock Text="Review historical backup execution logs, transaction receipts, omissions, and verification drills."
                                   FontSize="13"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Command="{Binding RefreshLogsCommand}"
                                Padding="12,8"
                                CornerRadius="6">
                            <TextBlock Text="↻ Refresh" FontWeight="SemiBold" FontSize="12" />
                        </Button>
                        <Button Command="{Binding RunVerificationDrillCommand}"
                                Classes="accent"
                                Padding="16,8"
                                CornerRadius="6"
                                IsEnabled="{Binding !IsDrillRunning}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="⚡ Run Verification Drill" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Verification Drill Drawer / Panel (Task 6.4) -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="#3B82F6"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    Padding="20"
                    IsVisible="{Binding IsDrillDrawerOpen}"
                    BoxShadow="0 8 32 0 #33000000">
                <StackPanel Spacing="16">
                    <!-- Drawer Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🛡️" FontSize="18" VerticalAlignment="Center" />
                                <TextBlock Text="Verification Drill &amp; Disaster Recovery Certification"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            </StackPanel>
                            <TextBlock Text="Multi-tier validation: validates dual-snapshot cryptographic receipts, restic repository data block hashes, and executes isolated sandbox sample restore drills."
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding CloseDrillDrawerCommand}"
                                Content="✕ Close"
                                Padding="12,6"
                                CornerRadius="6"
                                VerticalAlignment="Top" />
                    </Grid>

                    <!-- Drill Configuration Bar -->
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            CornerRadius="8"
                            Padding="14">
                        <Grid ColumnDefinitions="*,16,140,16,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Drill Level" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <ComboBox ItemsSource="{Binding DrillLevelOptions}"
                                          SelectedItem="{Binding SelectedDrillLevel}"
                                          HorizontalAlignment="Stretch"
                                          CornerRadius="6"
                                          IsEnabled="{Binding !IsDrillRunning}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Data Check Subset" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <ComboBox ItemsSource="{Binding DataSubsetOptions}"
                                          SelectedItem="{Binding SelectedDataSubset}"
                                          HorizontalAlignment="Stretch"
                                          CornerRadius="6"
                                          IsEnabled="{Binding !IsDrillRunning}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                                <Button Command="{Binding ExecuteConfiguredDrillCommand}"
                                        Classes="accent"
                                        Padding="18,8"
                                        CornerRadius="6"
                                        IsEnabled="{Binding !IsDrillRunning}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="⚡ Execute Drill" FontWeight="Bold" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Live Execution Progress / Status -->
                    <Border Background="#1E293B"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            IsVisible="{Binding IsDrillRunning}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="⏳" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="{Binding DrillProgressMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#93C5FD" VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="100" Height="4" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Drill Certification Outcome Card -->
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            CornerRadius="8"
                            Padding="16"
                            IsVisible="{Binding HasDrillResult}">
                        <StackPanel Spacing="14">
                            <!-- Outcome Header -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Certification Outcome" FontSize="14" FontWeight="Bold" />
                                    <TextBlock Text="{Binding DrillSummaryText}" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{Binding DrillResultBadgeColor}"
                                        CornerRadius="6"
                                        Padding="12,6"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DrillResultBadge}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="White" />
                                </Border>
                            </Grid>

                            <!-- 3 Tiers Result Cards -->
                            <Grid ColumnDefinitions="*,12,*,12,*">
                                <!-- Tier 1 Card -->
                                <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Tier 1: Metadata &amp; Receipts" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        <TextBlock Text="{Binding Level1Detail}" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Tier 2 Card -->
                                <Border Grid.Column="2" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Tier 2: Stored Chunk Hash" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        <TextBlock Text="{Binding Level2Detail}" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Tier 3 Card -->
                                <Border Grid.Column="4" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Tier 3: Sandbox Restore" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        <TextBlock Text="{Binding Level3Detail}" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Level 3 Restored Sample Files Table -->
                            <StackPanel Spacing="6" IsVisible="{Binding DrillSampleFiles.Count}">
                                <TextBlock Text="Level 3 Sandbox Restored Sample Files" FontSize="12" FontWeight="SemiBold" />
                                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="8">
                                    <StackPanel Spacing="6">
                                        <!-- Table Header -->
                                        <Grid ColumnDefinitions="*,90,110,90" Margin="4,0,4,2">
                                            <TextBlock Grid.Column="0" Text="Sample Path / File" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                            <TextBlock Grid.Column="1" Text="Size" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                            <TextBlock Grid.Column="2" Text="SHA-256 Hash" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                            <TextBlock Grid.Column="3" Text="Status" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Right" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding DrillSampleFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:DrillSampleFileViewModel">
                                                    <Grid ColumnDefinitions="*,90,110,90" Margin="4,2,4,2">
                                                        <TextBlock Grid.Column="0" Text="{Binding RelativePath}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding HashDisplay}" FontFamily="Consolas,monospace" FontSize="10" VerticalAlignment="Center" />
                                                        <Border Grid.Column="3" Background="{Binding StatusColor}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding StatusBadge}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Real-time Console Excerpt -->
                            <Expander Header="Drill Execution Console Log" IsExpanded="False" CornerRadius="6">
                                <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,6,0,0">
                                    <ScrollViewer MaxHeight="140">
                                        <ItemsControl ItemsSource="{Binding DrillLogLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding .}" FontFamily="Consolas,monospace" FontSize="10" Foreground="#94A3B8" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Search and Filter Bar -->
            <Grid ColumnDefinitions="*,16,140,16,140">
                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery}"
                         Watermark="Search activity by title, receipt ID, or log text..."
                         Padding="12,8"
                         CornerRadius="6" />

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding JobTypeFilters}"
                          SelectedItem="{Binding SelectedJobTypeFilter}"
                          HorizontalAlignment="Stretch"
                          CornerRadius="6" />

                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          HorizontalAlignment="Stretch"
                          CornerRadius="6" />
            </Grid>


            <!-- Master-Detail Layout (2 Columns) -->
            <Grid ColumnDefinitions="*,16,360" MinHeight="380">
                <!-- Left: Log History Items List -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="450">
                        <StackPanel Spacing="8">
                            <ItemsControl ItemsSource="{Binding FilteredLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ActivityLogItemViewModel">
                                        <Button Command="{Binding $parent[UserControl].((vm:ActivityViewModel)DataContext).SelectLogCommand}"
                                                CommandParameter="{Binding .}"
                                                Classes="category-card"
                                                Padding="12,10"
                                                Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <!-- Status Color Bar -->
                                                <Border Grid.Column="0"
                                                        Background="{Binding StatusBadgeColor}"
                                                        CornerRadius="3"
                                                        Width="6"
                                                        Margin="0,0,12,0" />

                                                <!-- Log Title and Subtitle -->
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding FormattedTimestamp, StringFormat='Captured {0}'}"
                                                               FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                    <TextBlock Text="{Binding BytesTransferredText, StringFormat='Transferred {0}'}"
                                                               FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                </StackPanel>

                                                <!-- Status Pill -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                                                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                                            CornerRadius="4" Padding="8,3">
                                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding DurationText}" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty Filtered Results -->
                            <TextBlock Text="No activity matching your search filter."
                                       IsVisible="{Binding !FilteredLogs.Count}"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Right: Audit Inspector Pane -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" IsVisible="{Binding HasSelectedLog}">
                            <!-- Inspector Header -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Audit Inspection"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                                <TextBlock Text="{Binding SelectedLog.Title}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Key Metrics Grid -->
                            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Job Type:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedLog.JobType}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Status:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedLog.Status}" FontSize="12" Foreground="{Binding SelectedLog.StatusBadgeColor}" FontWeight="Bold" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Start Time:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedLog.FormattedTimestamp}" FontSize="12" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Duration:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedLog.DurationText}" FontSize="12" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Items / Files:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedLog.FilesProcessed}" FontSize="12" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Processed Size:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedLog.BytesTransferredText}" FontSize="12" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Receipt / Ref:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedLog.ReceiptId}" FontSize="11" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Classification:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedLog.ConsistencyClass}" FontSize="12" Margin="0,0,0,6" />
                            </Grid>


                            <!-- Log Excerpt Box -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Journal Log Excerpt" FontSize="12" FontWeight="SemiBold" />
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                        CornerRadius="6"
                                        Padding="12">
                                    <TextBlock Text="{Binding SelectedLog.LogDetails}"
                                               FontSize="11"
                                               FontFamily="Consolas,Menlo,Monospace"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Status Banner -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
