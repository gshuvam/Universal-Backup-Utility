<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UniversalBackup.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="UniversalBackup.Desktop.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Margin="32">
            <!-- Header Card -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0"
                              Data="{StaticResource NavIconActivity}"
                              Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                              Width="32" Height="32"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Activity &amp; Audit Journal"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <TextBlock Text="Review historical backup execution logs, transaction receipts, omissions, and verification drills."
                                   FontSize="13"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Command="{Binding RefreshLogsCommand}"
                            Classes="accent"
                            Padding="16,8"
                            CornerRadius="6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Refresh Logs" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Activity List Placeholder / History Cards -->
            <StackPanel Spacing="12">
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Background="#10B981" CornerRadius="4" Width="8" Margin="0,0,16,0" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Backup Job: Daily Gamer Protection" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="Completed successfully in 4.2s • 1,420 files scanned, 4.2 GB processed • VSS snapshot verified"
                                       FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <TextBlock Text="Receipt ID: rcpt-9a4f-01 • Zero omissions" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Today, 10:00 PM"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </Grid>
                </Border>

                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Background="#10B981" CornerRadius="4" Width="8" Margin="0,0,16,0" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Integrity Verification Drill (Level 2)" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="Read data subset: 100% chunks matched • Zero corruption detected"
                                       FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <TextBlock Text="Catalog state: WAL synchronized" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Yesterday, 03:15 AM"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

