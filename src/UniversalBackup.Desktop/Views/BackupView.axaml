<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UniversalBackup.Desktop.ViewModels"
             xmlns:models="using:UniversalBackup.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="UniversalBackup.Desktop.Views.BackupView"
             x:DataType="vm:BackupViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24">

        <!-- ================================================================= -->
        <!-- 1. Header & Primary Action Bar                                     -->
        <!-- ================================================================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14"
                Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Vertical" Spacing="4">
                    <TextBlock Text="Backup Selection &amp; Discovery"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    <TextBlock Text="Select items to protect. Category cards display cached Stage 0 counts and live progressive discovery updates."
                               FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Overall Discovery Metric Badge -->
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Total Discovered:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalDiscoveredItemsCount, StringFormat='{}{0:N0} items'}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="•" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalDiscoveredFormattedSize}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#10B981"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Primary Action: Progressive System Scan -->
                    <Button Command="{Binding StartProgressiveScanCommand}"
                            Classes="accent"
                            IsEnabled="{Binding !IsBusy}"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource NavIconBackup}" Width="14" Height="14" />
                            <TextBlock Text="🔍 Scan System" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 2. Category Dashboard Cards (4x2 Uniform Grid)                     -->
        <!-- ================================================================= -->
        <Border Grid.Row="1" Margin="0,0,0,16">
            <ItemsControl ItemsSource="{Binding CategoryCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:CategoryCardModel">
                        <Button Classes="category-card"
                                Command="{Binding $parent[UserControl].((vm:BackupViewModel)DataContext).SelectCategoryCommand}"
                                CommandParameter="{Binding}"
                                Margin="4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- Category Icon Circle/Pill -->
                                <Border Grid.Column="0"
                                        Width="38" Height="38"
                                        CornerRadius="8"
                                        Background="{DynamicResource SystemControlHighlightListLowBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0">
                                    <PathIcon Data="{Binding IconGeometry}"
                                              Width="18" Height="18"
                                              Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>

                                <!-- Title, Size, and Count -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FormattedSize}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#10B981" />
                                    <TextBlock Text="{Binding ItemCount, StringFormat='{}{0:N0} detected'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>

                                <!-- Status Badge & Spinner -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                            BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2">
                                        <TextBlock Text="{Binding StatusBadge}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </Border>
                                    <ProgressBar IsIndeterminate="True"
                                                 IsVisible="{Binding IsScanning}"
                                                 Height="3"
                                                 Width="44"
                                                 HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ================================================================= -->
        <!-- 3. Selection & Presets Toolbar (2 Rows)                            -->
        <!-- ================================================================= -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="8" Margin="0,0,0,12">
            <!-- Toolbar Row 1: Instant Selection Presets -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="PRESETS:"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0" />

                        <Button Classes="preset-chip"
                                Classes.accent="{Binding IsPersonalEssentialsPreset}"
                                Command="{Binding ApplyPresetCommand}"
                                CommandParameter="Personal Essentials"
                                ToolTip.Tip="Selects Documents, desktop files, settings, and game saves. Excludes raw install binaries.">
                            <TextBlock Text="Personal Essentials" />
                        </Button>

                        <Button Classes="preset-chip"
                                Classes.accent="{Binding IsGameSavesOnlyPreset}"
                                Command="{Binding ApplyPresetCommand}"
                                CommandParameter="Game Saves Only"
                                ToolTip.Tip="Protects saves, configs, and screenshots across all detected game platforms.">
                            <TextBlock Text="Game Saves Only" />
                        </Button>

                        <Button Classes="preset-chip"
                                Classes.accent="{Binding IsGamesWithInstallationsPreset}"
                                Command="{Binding ApplyPresetCommand}"
                                CommandParameter="Games with Installations"
                                ToolTip.Tip="Selects entire game packages including full installation directories.">
                            <TextBlock Text="Games with Installations" />
                        </Button>

                        <Button Classes="preset-chip"
                                Classes.accent="{Binding IsEntireComputerPreset}"
                                Command="{Binding ApplyPresetCommand}"
                                CommandParameter="Entire Accessible Computer"
                                ToolTip.Tip="Selects all local volumes, user data, and applications with safety filters applied.">
                            <TextBlock Text="Entire Computer" />
                        </Button>

                        <Button Classes="preset-chip"
                                Classes.accent="{Binding IsCustomPreset}"
                                Command="{Binding ApplyPresetCommand}"
                                CommandParameter="Custom"
                                ToolTip.Tip="Active when individual items have been customized.">
                            <TextBlock Text="Custom" />
                        </Button>
                    </StackPanel>

                    <!-- Active Filter Category Pill Indicator -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource SystemControlHighlightListLowBrush}"
                            BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Category:" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentFilterCategory}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Toolbar Row 2: Search Filter & Tree Actions -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <!-- Search Box with Clear Button -->
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <TextBox Text="{Binding SearchFilterText}"
                             Watermark="Search by title, path, extension (.sav, .json), component, or provider..."
                             FontSize="12"
                             Height="34"
                             Padding="10,6,32,6"
                             CornerRadius="6"
                             VerticalContentAlignment="Center" />
                    <Button Command="{Binding ClearSearchFilterCommand}"
                            IsVisible="{Binding IsFilterActive}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            ToolTip.Tip="Clear search filter (Restore all items)">
                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </Button>
                </Grid>

                <!-- Match Count Pill -->
                <Border Grid.Column="1"
                        IsVisible="{Binding IsFilterActive}"
                        Background="{DynamicResource SystemControlHighlightListLowBrush}"
                        BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                    <TextBlock Text="{Binding FilterMatchCountText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                </Border>

                <!-- Select Visible -->
                <Button Grid.Column="2"
                        Command="{Binding SelectVisibleCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Padding="10,6"
                        Margin="0,0,8,0"
                        ToolTip.Tip="Check all currently visible items in the filtered tree">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="☑" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="Select Visible" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Deselect Visible -->
                <Button Grid.Column="3"
                        Command="{Binding DeselectVisibleCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Padding="10,6"
                        Margin="0,0,8,0"
                        ToolTip.Tip="Uncheck all currently visible items in the filtered tree">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="☐" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="Deselect Visible" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Select All -->
                <Button Grid.Column="4"
                        Command="{Binding SelectAllCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Padding="10,6"
                        Margin="0,0,8,0">
                    <TextBlock Text="Select All" FontSize="12" />
                </Button>

                <!-- Clear Selection -->
                <Button Grid.Column="5"
                        Command="{Binding ClearSelectionCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Padding="10,6"
                        Margin="0,0,8,0">
                    <TextBlock Text="Clear All" FontSize="12" />
                </Button>

                <!-- Expand All -->
                <Button Grid.Column="6"
                        Command="{Binding ExpandLevel1Command}"
                        IsEnabled="{Binding !IsBusy}"
                        Padding="10,6"
                        Margin="0,0,8,0">
                    <TextBlock Text="Expand All" FontSize="12" />
                </Button>

                <!-- Benchmark (250k nodes) -->
                <Button Grid.Column="7"
                        Command="{Binding LoadTreeCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Padding="12,6">
                    <TextBlock Text="⚡ Benchmark (250k)" FontSize="12" FontWeight="SemiBold" />
                </Button>
            </Grid>
        </StackPanel>

        <!-- ================================================================= -->
        <!-- 4. Central Split View: TreeDataGrid + Contextual Details Pane      -->
        <!-- ================================================================= -->
        <Grid Grid.Row="3" ColumnDefinitions="*,12,360">

            <!-- 4.1 Left: Virtualized TreeDataGrid -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <TreeDataGrid Source="{Binding TreeSource}"
                              Margin="8" />
            </Border>

            <!-- 4.2 Splitter Divider -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          Background="Transparent"
                          ResizeDirection="Columns" />

            <!-- 4.3 Right: Contextual Inspector Details Pane Card -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <!-- Populated State: Node Selected -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding ItemDetails.HasSelection}">
                        <StackPanel Margin="16" Spacing="14">

                            <!-- Header: Name & Type -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding ItemDetails.Title}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Background="{DynamicResource SystemControlHighlightListLowBrush}"
                                            BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2">
                                        <TextBlock Text="{Binding ItemDetails.NodeType}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                            CornerRadius="4"
                                            Padding="6,2">
                                        <TextBlock Text="{Binding ItemDetails.Category}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                            CornerRadius="4"
                                            Padding="6,2">
                                        <TextBlock Text="{Binding ItemDetails.FormattedSize}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#10B981" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <Separator Background="{DynamicResource SystemControlTransientBorderBrush}" Height="1" />

                            <!-- Path Section -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="PHYSICAL PATH"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                        BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,6">
                                    <SelectableTextBlock Text="{Binding ItemDetails.PrimaryPath}"
                                                         FontSize="11"
                                                         TextWrapping="Wrap"
                                                         FontFamily="Consolas, monospace" />
                                </Border>
                            </StackPanel>

                            <!-- Confidence & Consistency -->
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,6,0">
                                    <TextBlock Text="CONFIDENCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <TextBlock Text="{Binding ItemDetails.ConfidenceText}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="6,0,0,0">
                                    <TextBlock Text="PROVIDER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <TextBlock Text="{Binding ItemDetails.ProviderId}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="2">
                                <TextBlock Text="CONSISTENCY REQUIREMENT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBlock Text="{Binding ItemDetails.ConsistencyText}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Why is this included? (Plain English Rationale) -->
                            <Border Background="{DynamicResource SystemControlHighlightListLowBrush}"
                                    BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}"
                                    BorderThickness="1,0,0,0"
                                    Padding="10,8"
                                    CornerRadius="0,4,4,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Why is this included?"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                                    <TextBlock Text="{Binding ItemDetails.InclusionReason}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Exclusions (if any) -->
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderBrush="#F59E0B"
                                    BorderThickness="1,0,0,0"
                                    Padding="10,8"
                                    CornerRadius="0,4,4,0"
                                    IsVisible="{Binding ItemDetails.HasExclusion}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Exclusion Rationale"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#F59E0B" />
                                    <TextBlock Text="{Binding ItemDetails.ExclusionReason}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Component Decomposition Breakdown -->
                            <StackPanel Spacing="6" IsVisible="{Binding ItemDetails.Components.Count}">
                                <TextBlock Text="COMPONENT BREAKDOWN"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <ItemsControl ItemsSource="{Binding ItemDetails.Components}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ComponentDetailItem">
                                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,6"
                                                    Margin="0,2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Type}" FontSize="9" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding FormattedSize}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#10B981"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Empty State: No Node Selected -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10"
                                Margin="24"
                                IsVisible="{Binding !ItemDetails.HasSelection}">
                        <Border Width="48" Height="48"
                                CornerRadius="24"
                                Background="{DynamicResource SystemControlHighlightListLowBrush}"
                                HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource NavIconOverview}"
                                      Width="20" Height="20"
                                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="No Item Selected"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <TextBlock Text="Select an item in the tree to inspect its physical location, confidence level, components, and inclusion rationale."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

        <!-- ================================================================= -->
        <!-- 5. Bottom Selection Summary Bar & Telemetry                        -->
        <!-- ================================================================= -->
        <Border Grid.Row="4" Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Left: Status message -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           VerticalAlignment="Center" />

                <!-- Right: Live Selection Summary Pill & Telemetry -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Warning Pill if locked files require VSS -->
                    <Border Background="#33F59E0B"
                            BorderBrush="#F59E0B"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,4"
                            IsVisible="{Binding HasLockedFilesWarning}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource IconShieldCheck}" Width="12" Height="12" Foreground="#F59E0B" />
                            <TextBlock Text="VSS Snapshot Required" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" />
                        </StackPanel>
                    </Border>

                    <!-- Real-Time Selection Total Pill -->
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Selected:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedItemsCount, StringFormat='{}{0:N0} items'}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="•" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedFormattedSize}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#10B981"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Telemetry note -->
                    <TextBlock Text="Tree: Virtualized (60 FPS)"
                               FontSize="11"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
