<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UniversalBackup.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="UniversalBackup.Desktop.Views.DestinationsView"
             x:DataType="vm:DestinationsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Margin="32">
            <!-- Header Card -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0"
                              Data="{StaticResource NavIconDestinations}"
                              Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                              Width="32" Height="32"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Backup Storage Destinations"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <TextBlock Text="Manage local repository locations, removable USB backup targets, and cloud replication accounts."
                                   FontSize="13"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Command="{Binding RefreshDestinationsCommand}"
                            Classes="accent"
                            Padding="16,8"
                            CornerRadius="6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Check Health" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Destination Items -->
            <StackPanel Spacing="16">
                <!-- Local Destination -->
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <PathIcon Grid.Column="0" Data="{StaticResource NavIconDestinations}"
                                  Width="24" Height="24"
                                  Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                            <TextBlock Text="Primary Local Repository (Encrypted restic repo)" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="{Binding LocalRepositoryPath}" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <TextBlock Text="Status: Initialized • SQLite WAL Catalog Synchronized" FontSize="11" Foreground="#10B981" />
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                CornerRadius="4" Padding="10,6" VerticalAlignment="Center">
                            <TextBlock Text="Primary" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Cloud Destination 1: Google Drive -->
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <PathIcon Grid.Column="0" Data="{StaticResource NavIconBackup}"
                                  Width="24" Height="24"
                                  Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                            <TextBlock Text="Google Drive (Least-Privilege AppFolder)" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="OAuth 2.0 PKCE • drive.file scope restricted" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <TextBlock Text="{Binding GoogleDriveStatus, StringFormat='Status: {0}'}" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Connect" VerticalAlignment="Center" Padding="14,6" />
                    </Grid>
                </Border>

                <!-- Cloud Destination 2: OneDrive -->
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <PathIcon Grid.Column="0" Data="{StaticResource NavIconBackup}"
                                  Width="24" Height="24"
                                  Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                            <TextBlock Text="Microsoft OneDrive (AppFolder)" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="Microsoft Graph PKCE • Files.ReadWrite.AppFolder" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <TextBlock Text="{Binding OneDriveStatus, StringFormat='Status: {0}'}" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Connect" VerticalAlignment="Center" Padding="14,6" />
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
