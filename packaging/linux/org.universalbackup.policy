<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Universal Backup Project</vendor>
  <vendor_url>https://github.com/gshuvam/Universal-Backup-Utility</vendor_url>
  <icon_name>org.universalbackup.UniversalBackup</icon_name>

  <action id="org.universalbackup.helper">
    <description>Run Universal Backup Privileged Helper</description>
    <message>Authentication is required to perform privileged volume operations and locked file backups.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/universalbackup/UniversalBackup.PrivilegedHelper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
