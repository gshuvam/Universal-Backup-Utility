<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap desktop">

  <Identity
    Name="UniversalBackup.Desktop"
    Publisher="CN=UniversalBackupProject"
    Version="1.0.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Universal Backup Utility</DisplayName>
    <PublisherDisplayName>Universal Backup Project</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Modern, encrypted, deduplicated personal and game backup utility with cloud replication and instant disaster recovery.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="UniversalBackup.Desktop.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Universal Backup Utility"
        Description="Universal Backup Desktop Application"
        BackgroundColor="#0f172a"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.appExecutionAlias">
          <desktop:AppExecutionAlias>
            <desktop:ExecutionAlias Executable="universalbackup.exe" />
          </desktop:AppExecutionAlias>
        </desktop:Extension>
        <desktop:Extension Category="windows.appExecutionAlias">
          <desktop:AppExecutionAlias>
            <desktop:ExecutionAlias Executable="universalbackup-cli.exe" />
          </desktop:AppExecutionAlias>
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="broadFileSystemAccess" />
  </Capabilities>
</Package>
