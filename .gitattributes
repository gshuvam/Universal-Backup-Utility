# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code and markup files
*.cs text eol=lf
*.axaml text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows specific scripts and solution files
*.sln text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.dll binary
*.exe binary
*.db binary
*.sqlite binary
*.sqlite3 binary
